<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paint IMS V2 - Paint Shop Inventory SaaS</title>
  <!-- Google Font: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Bootstrap 5.3 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome 6.4 CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<style>
    :root {
      --primary: #0EA5E9;
      --primary-hover: #0284C7;
      --primary-light: #E0F2FE;
      --dark: #0F172A;
      --secondary: #64748B;
      --bg: #F8FAFC;
      --card-bg: #FFFFFF;
      --border: #E2E8F0;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.12) 0%, rgba(248, 250, 252, 1) 75%);
      color: var(--dark);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      margin: 0;
      position: relative;
    }

    body::before {
      content: '';
      position: absolute;
      top: -100px;
      right: -100px;
      width: 350px;
      height: 350px;
      background: rgba(14, 165, 233, 0.08);
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
    }

    body::after {
      content: '';
      position: absolute;
      bottom: -100px;
      left: -100px;
      width: 350px;
      height: 350px;
      background: rgba(99, 102, 241, 0.06);
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
    }

    .login-card {
      background: var(--card-bg);
      border: 1px solid rgba(226, 232, 240, 0.9);
      border-radius: 1.25rem;
      box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.07), 0 0 1px 1px rgba(255, 255, 255, 0.8) inset;
      width: 100%;
      max-width: 440px;
      padding: 2.75rem 2.25rem;
      position: relative;
      z-index: 10;
      backdrop-filter: blur(10px);
    }

    .brand-icon {
      width: 3.5rem;
      height: 3.5rem;
      background: linear-gradient(135deg, #38BDF8, #0EA5E9, #0284C7);
      color: white;
      border-radius: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      margin: 0 auto 1.25rem auto;
      box-shadow: 0 8px 20px -4px rgba(14, 165, 233, 0.4);
      transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .login-card:hover .brand-icon {
      transform: scale(1.05) rotate(-3deg);
    }

    .form-control {
      border: 1px solid var(--border);
      border-radius: 0.625rem;
      padding: 0.7rem 0.9rem;
      font-size: 0.95rem;
      transition: all 0.2s ease;
      background-color: #FAFAFA;
    }

    .form-control:focus {
      border-color: var(--primary);
      background-color: #FFFFFF;
      box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.12);
    }

    .input-group-text {
      background: #F1F5F9;
      border: 1px solid var(--border);
      border-right: none;
      color: var(--secondary);
      border-radius: 0.625rem 0 0 0.625rem;
      padding-left: 0.9rem;
      padding-right: 0.9rem;
    }

    .input-group .form-control {
      border-left: none;
    }

    .input-group .btn-password-toggle {
      border: 1px solid var(--border);
      border-left: none;
      background: #F1F5F9;
      color: var(--secondary);
      border-radius: 0 0.625rem 0.625rem 0;
      transition: all 0.2s ease;
    }

    .input-group .btn-password-toggle:hover {
      color: var(--dark);
      background: #E2E8F0;
    }

    .btn-primary-custom {
      background: linear-gradient(135deg, #0EA5E9, #0284C7);
      border: none;
      color: white;
      font-weight: 600;
      padding: 0.8rem 1.25rem;
      border-radius: 0.625rem;
      width: 100%;
      letter-spacing: 0.01em;
      box-shadow: 0 4px 12px rgba(14, 165, 233, 0.25);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-primary-custom:hover {
      background: linear-gradient(135deg, #0284C7, #0369A1);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(14, 165, 233, 0.35);
      color: white;
    }

    .alert-custom {
      border-radius: 0.625rem;
      font-size: 0.875rem;
      border: none;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .reset-notice-box {
      background-color: #F0F9FF;
      border: 1px solid #BAE6FD;
      border-radius: 0.625rem;
      padding: 0.9rem;
      margin-bottom: 1.25rem;
      font-size: 0.875rem;
      color: #0369A1;
    }
  </style>
</head>
<body>

<div class="login-card">
  <!-- Brand Header -->
  <div class="text-center mb-4">
    <div class="brand-icon">
      <i class="fa-solid fa-fill-drip"></i>
    </div>
    <h4 class="fw-bold mb-1" style="color: var(--dark);">Paint IMS V2</h4>
    <p class="text-secondary small mb-0">Multi-tenant Paint Shop Inventory Management</p>
  </div>

  <!-- Alert Messages -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-custom mb-3" role="alert">
      <i class="fa-solid fa-circle-exclamation me-1"></i> <%= error %>
    </div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-custom mb-3" role="alert">
      <i class="fa-solid fa-circle-check me-1"></i> <%= success %>
    </div>
  <% } %>

  <!-- Mode 1: LOGIN -->
  <% if (viewMode === 'login') { %>
    <form action="/login" method="POST" id="loginForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label for="email" class="form-label small fw-semibold text-secondary">Email Address</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
          <input type="email" class="form-control" id="email" name="email" placeholder="name@paintshop.com" required autofocus>
        </div>
      </div>

      <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <label for="password" class="form-label small fw-semibold text-secondary mb-0">Password</label>
          <a href="/forgot-password" class="small text-decoration-none" style="color: var(--primary);">Forgot password?</a>
        </div>
        <div class="input-group">
          <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
          <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
          <button class="btn btn-password-toggle" type="button" onclick="togglePasswordVisibility('password', this)" aria-label="Toggle password visibility">
            <i class="fa-regular fa-eye"></i>
          </button>
        </div>
      </div>

      <button type="submit" class="btn btn-primary-custom mt-2">
        <i class="fa-solid fa-right-to-bracket me-2"></i> Sign In
      </button>
    </form>


  <% } %>

  <!-- Mode 2: FORGOT PASSWORD -->
  <% if (viewMode === 'forgot') { %>
    <div class="mb-3 text-center">
      <h5 class="fw-semibold">Super Admin Password Recovery</h5>
      <p class="text-muted small">Enter your Super Admin email address to generate reset credentials.</p>
    </div>

    <% if (typeof token !== 'undefined' && token) { %>
      <div class="reset-notice-box">
        <div class="fw-bold mb-1"><i class="fa-solid fa-key me-1"></i> Admin Reset Token Link:</div>
        <div class="small text-break">
          <a href="<%= token %>" class="fw-bold text-decoration-underline" style="color: var(--primary);"><%= token %></a>
        </div>
        <div class="extra-small text-muted mt-1">Token valid for 15 minutes.</div>
      </div>
    <% } %>

    <form action="/forgot-password" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label for="email" class="form-label small fw-semibold text-secondary">Super Admin Email</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
          <input type="email" class="form-control" id="email" name="email" placeholder="admin@gmail.com" required autofocus>
        </div>
      </div>

      <button type="submit" class="btn btn-primary-custom mb-3">
        Generate Reset Link
      </button>

      <div class="text-center">
        <a href="/login" class="small text-decoration-none text-secondary">
          <i class="fa-solid fa-arrow-left me-1"></i> Back to Sign In
        </a>
      </div>
    </form>
  <% } %>

  <!-- Mode 3: RESET PASSWORD -->
  <% if (viewMode === 'reset') { %>
    <div class="mb-3 text-center">
      <h5 class="fw-semibold">Set New Password</h5>
      <p class="text-muted small">Please enter your new password below.</p>
    </div>

    <form action="/reset-password" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= token %>">

      <div class="mb-3">
        <label for="password" class="form-label small fw-semibold text-secondary">New Password (min 8 chars)</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
          <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required minlength="8">
        </div>
      </div>

      <div class="mb-3">
        <label for="confirm_password" class="form-label small fw-semibold text-secondary">Confirm New Password</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
          <input type="password" class="form-control" id="confirm_password" name="confirm_password" placeholder="••••••••" required minlength="8">
        </div>
      </div>

      <button type="submit" class="btn btn-primary-custom mb-3">
        Save New Password
      </button>

      <div class="text-center">
        <a href="/login" class="small text-decoration-none text-secondary">
          <i class="fa-solid fa-arrow-left me-1"></i> Cancel & Return to Login
        </a>
      </div>
    </form>
  <% } %>

</div>

<script>
  function togglePasswordVisibility(id, btn) {
    const input = document.getElementById(id);
    const icon = btn.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'fa-regular fa-eye-slash';
    } else {
      input.type = 'password';
      icon.className = 'fa-regular fa-eye';
    }
  }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
