<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paint IMS V2 - Paint Shop Inventory SaaS</title>
  <!-- Google Font: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Bootstrap 5.3 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome 6.4 CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<style>
    :root {
      --primary: #2563EB;
      --primary-hover: #1D4ED8;
      --dark-slate: #0F172A;
      --text-main: #0F172A;
      --text-muted: #64748B;
      --bg: #FAFAFA;
      --card-bg: #FFFFFF;
      --border-color: #E2E8F0;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      margin: 0;
      -webkit-font-smoothing: antialiased;
    }

    .login-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 1rem;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04), 0 1px 3px 0 rgba(15, 23, 42, 0.02);
      width: 100%;
      max-width: 420px;
      padding: 2.5rem 2rem;
      position: relative;
    }

    .brand-icon {
      width: 3.5rem;
      height: 3.5rem;
      background: #0F172A;
      color: #FFFFFF;
      border-radius: 0.875rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin: 0 auto 1.25rem auto;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
      transition: transform 0.2s ease;
    }

    .login-card:hover .brand-icon {
      transform: scale(1.04);
    }

    .form-control {
      border: 1px solid #E2E8F0;
      border-radius: 0.5rem;
      padding: 0.65rem 0.85rem;
      font-size: 0.925rem;
      transition: all 0.15s ease;
      background-color: #F8FAFC;
      color: #0F172A;
    }

    .form-control::placeholder {
      color: #94A3B8;
    }

    .form-control:focus {
      border-color: #2563EB;
      background-color: #FFFFFF;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
      color: #0F172A;
    }

    .input-group-text {
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-right: none;
      color: #64748B;
      border-radius: 0.5rem 0 0 0.5rem;
      padding-left: 0.85rem;
      padding-right: 0.85rem;
    }

    .input-group .form-control {
      border-left: none;
    }

    .input-group .btn-password-toggle {
      border: 1px solid #E2E8F0;
      border-left: none;
      background: #F8FAFC;
      color: #64748B;
      border-radius: 0 0.5rem 0.5rem 0;
      transition: all 0.15s ease;
    }

    .input-group .btn-password-toggle:hover {
      color: #0F172A;
      background: #E2E8F0;
    }

    .btn-primary-custom {
      background: #0F172A;
      border: none;
      color: white;
      font-weight: 600;
      padding: 0.75rem 1.25rem;
      border-radius: 0.5rem;
      width: 100%;
      letter-spacing: 0.01em;
      box-shadow: 0 2px 4px rgba(15, 23, 42, 0.1);
      transition: all 0.15s ease;
    }

    .btn-primary-custom:hover {
      background: #1E293B;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
      color: white;
    }

    .alert-custom {
      border-radius: 0.5rem;
      font-size: 0.875rem;
      border: none;
    }

    .reset-notice-box {
      background-color: #EFF6FF;
      border: 1px solid #BFDBFE;
      border-radius: 0.5rem;
      padding: 0.85rem;
      margin-bottom: 1.25rem;
      font-size: 0.875rem;
      color: #1D4ED8;
    }
  </style>
</head>
<body>

<div class="login-card">
  <!-- Brand Header -->
  <div class="text-center mb-4">
    <div class="brand-icon">
      <i class="fa-solid fa-fill-drip"></i>
    </div>
    <h4 class="fw-bold mb-1" style="color: #0F172A;">Paint IMS V2</h4>
    <p class="text-secondary small mb-0">Multi-tenant Paint Shop Inventory Management</p>
  </div>

  <!-- Alert Messages -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-custom mb-3" role="alert">
      <i class="fa-solid fa-circle-exclamation me-1"></i> <%= error %>
    </div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-custom mb-3" role="alert">
      <i class="fa-solid fa-circle-check me-1"></i> <%= success %>
    </div>
  <% } %>

  <!-- Mode 1: LOGIN -->
  <% if (viewMode === 'login') { %>
    <form action="/login" method="POST" id="loginForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label for="email" class="form-label small fw-semibold text-secondary">Email Address</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
          <input type="email" class="form-control" id="email" name="email" placeholder="name@paintshop.com" required autofocus>
        </div>
      </div>

      <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <label for="password" class="form-label small fw-semibold text-secondary mb-0">Password</label>
          <a href="/forgot-password" class="small text-decoration-none fw-medium" style="color: #2563EB;">Forgot password?</a>
        </div>
        <div class="input-group">
          <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
          <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
          <button class="btn btn-password-toggle" type="button" onclick="togglePasswordVisibility('password', this)" aria-label="Toggle password visibility">
            <i class="fa-regular fa-eye"></i>
          </button>
        </div>
      </div>

      <button type="submit" class="btn btn-primary-custom mt-2">
        <i class="fa-solid fa-right-to-bracket me-2"></i> Sign In
      </button>
    </form>


  <% } %>

  <!-- Mode 2: FORGOT PASSWORD -->
  <% if (viewMode === 'forgot') { %>
    <div class="mb-3 text-center">
      <h5 class="fw-semibold">Super Admin Password Recovery</h5>
      <p class="text-muted small">Enter your Super Admin email address to generate reset credentials.</p>
    </div>

    <% if (typeof token !== 'undefined' && token) { %>
      <div class="reset-notice-box">
        <div class="fw-bold mb-1"><i class="fa-solid fa-key me-1"></i> Admin Reset Token Link:</div>
        <div class="small text-break">
          <a href="<%= token %>" class="fw-bold text-decoration-underline" style="color: var(--primary);"><%= token %></a>
        </div>
        <div class="extra-small text-muted mt-1">Token valid for 15 minutes.</div>
      </div>
    <% } %>

    <form action="/forgot-password" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label for="email" class="form-label small fw-semibold text-secondary">Super Admin Email</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
          <input type="email" class="form-control" id="email" name="email" placeholder="admin@gmail.com" required autofocus>
        </div>
      </div>

      <button type="submit" class="btn btn-primary-custom mb-3">
        Generate Reset Link
      </button>

      <div class="text-center">
        <a href="/login" class="small text-decoration-none text-secondary">
          <i class="fa-solid fa-arrow-left me-1"></i> Back to Sign In
        </a>
      </div>
    </form>
  <% } %>

  <!-- Mode 3: RESET PASSWORD -->
  <% if (viewMode === 'reset') { %>
    <div class="mb-3 text-center">
      <h5 class="fw-semibold">Set New Password</h5>
      <p class="text-muted small">Please enter your new password below.</p>
    </div>

    <form action="/reset-password" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= token %>">

      <div class="mb-3">
        <label for="password" class="form-label small fw-semibold text-secondary">New Password (min 8 chars)</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
          <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required minlength="8">
        </div>
      </div>

      <div class="mb-3">
        <label for="confirm_password" class="form-label small fw-semibold text-secondary">Confirm New Password</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
          <input type="password" class="form-control" id="confirm_password" name="confirm_password" placeholder="••••••••" required minlength="8">
        </div>
      </div>

      <button type="submit" class="btn btn-primary-custom mb-3">
        Save New Password
      </button>

      <div class="text-center">
        <a href="/login" class="small text-decoration-none text-secondary">
          <i class="fa-solid fa-arrow-left me-1"></i> Cancel & Return to Login
        </a>
      </div>
    </form>
  <% } %>

</div>

<script>
  function togglePasswordVisibility(id, btn) {
    const input = document.getElementById(id);
    const icon = btn.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'fa-regular fa-eye-slash';
    } else {
      input.type = 'password';
      icon.className = 'fa-regular fa-eye';
    }
  }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
