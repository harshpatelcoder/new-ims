<script>
  function copyTempPassword() {
    const passElem = document.getElementById('tempPassText');
    if (!passElem) return;
    navigator.clipboard.writeText(passElem.innerText).then(() => {
      alert('Temporary password copied to clipboard!');
    }).catch(err => {
      alert('Failed to copy text: ' + err);
    });
  }

  function editProductModal(p) {
    document.getElementById('edit_product_id').value = p._id;
    document.getElementById('edit_name').value = p.name || '';
    document.getElementById('edit_brand').value = p.brand || '';
    document.getElementById('edit_category').value = p.category || '';
    document.getElementById('edit_shade').value = p.shade || '';
    document.getElementById('edit_size').value = p.size || '';
    document.getElementById('edit_purchase_price').value = p.purchase_price || 0;
    document.getElementById('edit_selling_price').value = p.selling_price || 0;
    document.getElementById('edit_minimum_stock').value = p.minimum_stock || 5;
    document.getElementById('edit_supplier_id').value = p.supplier_id ? (p.supplier_id._id || p.supplier_id) : '';
    document.getElementById('edit_description').value = p.description || '';

    const modal = new bootstrap.Modal(document.getElementById('editProductModal'));
    modal.show();
  }

  function editSupplierModal(sup) {
    document.getElementById('edit_sup_id').value = sup._id;
    document.getElementById('edit_sup_name').value = sup.name || '';
    document.getElementById('edit_sup_phone').value = sup.phone || '';
    document.getElementById('edit_sup_email').value = sup.email || '';
    document.getElementById('edit_sup_address').value = sup.address || '';

    const modal = new bootstrap.Modal(document.getElementById('editSupplierModal'));
    modal.show();
  }

  function confirmDeleteProduct(id, name) {
    document.getElementById('delete_page').value = 'inventory';
    document.getElementById('delete_action').value = 'delete_product';
    document.getElementById('delete_product_id').value = id;
    document.getElementById('deleteConfirmMessage').innerText = `Are you sure you want to delete product "${name}" from inventory?`;

    const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
    modal.show();
  }

  function confirmDeleteShop(id, name) {
    document.getElementById('delete_page').value = 'shops';
    document.getElementById('delete_action').value = 'delete_shop';
    document.getElementById('delete_shop_id').value = id;
    document.getElementById('deleteConfirmMessage').innerText = `Are you sure you want to delete shop "${name}"? This will permanently delete all shop users, products, suppliers, and stock transactions!`;

    const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
    modal.show();
  }
</script>

<% if (page === 'dashboard' && typeof dashboardData !== 'undefined' && dashboardData.categoryBreakdown) { %>
<script>
  (function() {
    function initChart() {
      const ctx = document.getElementById('categoryChart');
      if (!ctx) return;
      if (typeof Chart === 'undefined') {
        setTimeout(initChart, 100);
        return;
      }

      const rawBreakdown = <%- JSON.stringify(dashboardData.categoryBreakdown || []) %>;
      let labels = rawBreakdown.map(c => c._id ? String(c._id) : "General Paint");
      let data = rawBreakdown.map(c => Number(c.count) || 0);

      const hasData = labels.length > 0 && data.some(val => val > 0);

      if (!hasData) {
        labels = ['No Products Added Yet'];
        data = [1];
      }

      const palette = ['#0EA5E9', '#10B981', '#F59E0B', '#6366F1', '#EC4899', '#8B5CF6', '#0284C7', '#64748B'];
      const backgroundColors = hasData 
        ? palette.slice(0, labels.length)
        : ['#E2E8F0'];

      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: labels,
          datasets: [{
            data: data,
            backgroundColor: backgroundColors,
            borderWidth: 2,
            borderColor: '#FFFFFF',
            hoverOffset: hasData ? 6 : 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '70%',
          plugins: {
            legend: { 
              position: 'bottom',
              labels: {
                usePointStyle: true,
                padding: 16,
                font: {
                  family: "'Inter', sans-serif",
                  size: 12,
                  weight: '500'
                }
              }
            },
            tooltip: {
              enabled: hasData,
              padding: 10,
              cornerRadius: 8,
              backgroundColor: '#0F172A',
              titleFont: { family: "'Inter', sans-serif", size: 13, weight: '600' },
              bodyFont: { family: "'Inter', sans-serif", size: 12 }
            }
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initChart);
    } else {
      initChart();
    }
  })();
</script>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
